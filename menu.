#include <iostream>
using namespace std;

void menu()
{
    int choice;

    cout << "\n--- RESTAURANT MENU ---" << endl;
    cout << "1. Pizza" << endl;
    cout << "2. Burger" << endl;
    cout << "3. Sandwich" << endl;
    cout << "4. Exit" << endl;

    cout << "Enter your choice: ";
    cin >> choice;

    if(choice == 1)
        cout << "You selected Pizza." << endl;

    else if(choice == 2)
        cout << "You selected Burger." << endl;

    else if(choice == 3)
        cout << "You selected Sandwich." << endl;

    else if(choice == 4)
    {
        cout << "Thank you!" << endl;
        return;
    }

    else
        cout << "Invalid choice." << endl;

    menu();   // recursion
}

int main()
{
    menu();

    return 0;
}
