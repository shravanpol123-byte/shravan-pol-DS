#include <iostream>
#include <queue>
using namespace std;

int main()
{
    queue<int> q;
    int token;

    cout << "Enter 5 token numbers:\n";

    for(int i = 0; i < 5; i++)
    {
        cin >> token;
        q.push(token);
    }

    cout << "\nCustomers served:\n";

    for(int i = 0; i < 5; i++)
    {
        cout << "Token " << q.front() << " served\n";
        q.pop();
    }

    return 0;
}
