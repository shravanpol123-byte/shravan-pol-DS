#include<iostream>
using namespace std;
int main()
{
    int bookIDs[5];
    cout<<"Enter the IDs of 5 library Books: \n";

    for(int i=0; i<5; i++)
    {
        cout<<"Book"<<(i+1)<< ": ";
        cin>>bookIDs[i];
    }
    for(int i=0; i<5-1; i++)
    {
        for(int j = i+1; j<5; j++)
        {
          if(bookIDs[j] < bookIDs[i])
          {
            int temp = bookIDs[i];
          bookIDs[i] = bookIDs[j];
          bookIDs[j] = temp;
          }
        }
    }
    cout<<"\n-======IDs in Ascending Order======-\n";
    for(int i=0; i<5; i++)
    {
        cout<<bookIDs[i]<<" ";
    }
    cout<<endl;
    return 0;
}
